# Optional: Contact Form Endpoint (e.g., https://formspree.io/f/your-form-id)
# If omitted, the contact form cleanly falls back to a pre-filled mailto: link and copy-to-clipboard action.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Optional: Override contact placeholders via environment variables on Vercel
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=https://github.com/latexzur-art
